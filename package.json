{
  "name": "video-feed-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker \"npm run dev -w apps/api\" \"npm run dev -w apps/worker\"",
    "migrate": "npm run migrate -w apps/api",
    "seed": "npm run seed -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
